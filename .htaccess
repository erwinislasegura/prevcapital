Options -Indexes
RewriteEngine On

RewriteRule ^(app|config|core|database|routes|storage|cron)/ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^(bootstrap\.php|\.env|composer\.(json|lock)|README\.md)$">
    Require all denied
</FilesMatch>
